# Copy this file to .env locally. Never commit the real .env file.
# Enable the Google Places API (New) for the Google Cloud project that owns this key.
MATRIX360_DEPLOYMENT_STAGE=local
GOOGLE_MAPS_API_KEY=

# The existing gateway injects this into every staging request; never expose it to browser JavaScript.
MATRIX360_APP_ACCESS_KEY=

# Shared only with the Avinash CRM backend, never with browser JavaScript.
MATRIX360_INTEGRATION_KEY=
