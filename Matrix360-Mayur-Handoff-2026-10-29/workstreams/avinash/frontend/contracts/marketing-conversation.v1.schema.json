{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matrix360.local/contracts/marketing-conversation.v1.schema.json",
  "title": "Matrix360 Marketing Conversation v1",
  "type": "object",
  "required": ["schema_version", "conversation_id", "correlation_id", "workspace_id", "status", "execution_mode", "messages", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "conversation_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "parent_task_id": { "type": ["string", "null"] },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["clarification_required", "ready_to_dispatch", "dispatched", "blocked", "failed"] },
    "execution_mode": { "enum": ["deterministic_fallback", "live_ai", "blocked", "failed"] },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message_id", "role", "content", "sequence", "created_at"],
        "properties": {
          "message_id": { "type": "string", "format": "uuid" },
          "role": { "enum": ["user", "assistant", "system"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "sequence": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
