# Copy to .env and add your own values. Do not commit .env.
# AI generates the plain-English research plan, filters, qualification, and company size estimation.
# Works with OpenAI (e.g. gpt-4o-mini, gpt-4o), OpenRouter, or Gemini.
LEAD_AI_API_KEY=
LEAD_AI_MODEL=gpt-4o-mini

# (Optional) Google Cloud project key with Places API (New) enabled.
# If left empty, the tool automatically uses multi-engine web & LinkedIn discovery.
GOOGLE_MAPS_API_KEY=
