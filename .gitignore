# Exclude sensitive environment configuration (User requirement: no .env.local or secrets)
.env
.env.*
*.env
*.env.*
!.env.example
**/.env.local
**/.env

# Private credentials and config directory
MATRIX360_PRIVATE_CONFIG/.env

# Dependencies
node_modules/
**/node_modules/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime and build logs
*.log
**/*.log

# Internal git backup markers
.git_backup
**/.git_backup

# Python bytecode and caches
__pycache__/
*.pyc
.pytest_cache/
